package calendar

// CalendarExample demonstrates the simplified calendar component
templ CalendarExample() {
	<div class="max-w-2xl mx-auto p-6 space-y-8">
		<h1 class="text-2xl font-bold">Calendar Component</h1>
		
		<!-- Single mode calendar -->
		<div class="space-y-4">
			<h2 class="text-lg font-semibold">Single Date Selection</h2>
			<div class="border rounded-lg">
				@Calendar(CalendarProps{
					ID:   "calendar-single",
					Mode: "single",
				})
			</div>
			<div class="text-sm text-muted-foreground">
				<p>Click on any date to select it. The selected date will be highlighted.</p>
			</div>
		</div>

		<!-- Range mode calendar -->
		<div class="space-y-4">
			<h2 class="text-lg font-semibold">Date Range Selection</h2>
			<div class="border rounded-lg">
				@Calendar(CalendarProps{
					ID:   "calendar-range",
					Mode: "range",
				})
			</div>
			<div class="text-sm text-muted-foreground">
				<p>Click to select a start date, then click another date to complete the range.</p>
			</div>
		</div>

		<!-- Calendar with event listener -->
		<div class="space-y-4">
			<h2 class="text-lg font-semibold">Calendar with Event Handling</h2>
			<div class="border rounded-lg">
				@Calendar(CalendarProps{
					ID:   "calendar-events",
					Mode: "single",
				})
			</div>
			<div 
				class="p-3 bg-muted rounded text-sm"
			>
				<p><strong>Selected Date:</strong> <span data-text="$calendar_events_selectedDate || 'None'"></span></p>
			</div>
		</div>
	</div>
} 