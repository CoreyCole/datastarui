package calendar

import (
	"crypto/rand"
	"fmt"
	"github.com/coreycole/datastarui/utils"
	"time"
)

// CalendarDayData represents pre-calculated day information
type CalendarDayData struct {
	DateString     string // YYYY-MM-DD format
	DayNumber      int    // Day of month (1-31)
	IsCurrentMonth bool   // Is this day in the target month
	IsToday        bool   // Is this today's date
	IsOutsideDay   bool   // Is this day outside the target month
}

// calculateDayData pre-calculates day information in Go instead of complex JS expressions
func calculateDayData(dayIndex, monthOffset int, currentDateSignal, todaySignal string) CalendarDayData {
	// For now, return simple sequential day numbers to make days visible
	// dayIndex ranges from 0-34 (35 days), so we'll show 1-31 and wrap
	dayNumber := (dayIndex % 31) + 1
	
	return CalendarDayData{
		DateString:     fmt.Sprintf("2024-01-%02d", dayNumber),
		DayNumber:      dayNumber,
		IsCurrentMonth: true,
		IsToday:        dayIndex == 15, // Make 16th day "today" for testing
		IsOutsideDay:   false,
	}
}

// CalendarSignals defines the signal structure for calendar components
type CalendarSignals struct {
	CurrentDate  string `json:"currentDate"`
	Mode         string `json:"mode"`
	Today        string `json:"today"`
	SelectedDate string `json:"selectedDate"`
	RangeStart   string `json:"rangeStart"`
	RangeEnd     string `json:"rangeEnd"`
}

// Calendar renders a simple, elegant calendar
templ Calendar(props CalendarProps) {
	{{
		// Generate unique ID
		calendarID := props.ID
		if calendarID == "" {
			b := make([]byte, 4)
			rand.Read(b)
			calendarID = fmt.Sprintf("calendar_%x", b)
		}

		// Set defaults
		mode := props.Mode
		if mode == "" {
			mode = "single"
		}

		numberOfMonths := props.NumberOfMonths
		if numberOfMonths <= 0 {
			numberOfMonths = 1
		}

		// Determine the initial month to display
		var currentDateStr string
		now := time.Now()
		if props.DefaultDate != "" {
			// Use the provided DefaultDate, normalized to first day of month
			if t, err := time.Parse("2006-01-02", props.DefaultDate); err == nil {
				currentDateStr = fmt.Sprintf("%04d-%02d-01", t.Year(), int(t.Month()))
			} else {
				// Fallback to current month if DefaultDate is invalid
				currentDateStr = fmt.Sprintf("%04d-%02d-01", now.Year(), int(now.Month()))
			}
		} else {
			// Default to current month
			currentDateStr = fmt.Sprintf("%04d-%02d-01", now.Year(), int(now.Month()))
		}

		// Today string for highlighting
		todayStr := now.Format("2006-01-02")

		// Create signals using the structured system
		signals := utils.Signals(calendarID, CalendarSignals{
			CurrentDate:  currentDateStr,
			Mode:         mode,
			Today:        todayStr,
			SelectedDate: props.SelectedDate,
			RangeStart:   props.RangeStart,
			RangeEnd:     props.RangeEnd,
		})

		classes := calendarVariants(props.Class)
	}}
	<div
		data-signals={ signals.DataSignals }
		class={ "p-3 " + classes }
		{ props.Attributes... }
	>
		@CalendarHeader(CalendarHeaderProps{ID: calendarID, NumberOfMonths: numberOfMonths})
		<!-- Months container with responsive flex layout -->
		if numberOfMonths == 1 {
			<!-- Single month layout -->
			@CalendarGrid(CalendarGridProps{
				ID:                 calendarID,
				MonthOffset:        0,
				HideOutsideDays:    props.HideOutsideDays,
				NumberOfMonths:     numberOfMonths,
				DatePickerInputsID: props.DatePickerInputsID,
			})
		} else {
			<!-- Multi-month layout - each month looks like a single calendar -->
			<div class="flex flex-col sm:flex-row gap-8">
				for monthIndex := 0; monthIndex < numberOfMonths; monthIndex++ {
					<div class="flex-1">
						<!-- Individual month header -->
						<div class="flex justify-center pt-1 relative items-center w-full mb-4">
							<div class="text-sm font-medium">
								<span data-text={ "new Date(Date.UTC(new Date(" + signals.Signal("currentDate") + " + 'T12:00:00Z').getUTCFullYear(), new Date(" + signals.Signal("currentDate") + " + 'T12:00:00Z').getUTCMonth() + " + fmt.Sprintf("%d", monthIndex) + ", 1, 12, 0, 0)).toLocaleString('default', { month: 'long', year: 'numeric', timeZone: 'UTC' })" }></span>
							</div>
						</div>
						@CalendarGrid(CalendarGridProps{
							ID:                 calendarID,
							MonthOffset:        monthIndex,
							HideOutsideDays:    props.HideOutsideDays,
							NumberOfMonths:     numberOfMonths,
							DatePickerInputsID: props.DatePickerInputsID,
						})
					</div>
				}
			</div>
		}
	</div>
}

// CalendarHeader renders the month navigation
templ CalendarHeader(props CalendarHeaderProps) {
	{{
		// Create signals manager for this calendar
		signals := utils.Signals(props.ID, CalendarSignals{})

		// Signal references
		currentDateRef := signals.Signal("currentDate")

		// Navigation expressions - simplified UTC approach
		prevMonthExpr := signals.Set("currentDate", "new Date(Date.UTC(new Date("+currentDateRef+").getUTCFullYear(), new Date("+currentDateRef+").getUTCMonth() - 1, 1)).toISOString().slice(0, 10)")
		nextMonthExpr := signals.Set("currentDate", "new Date(Date.UTC(new Date("+currentDateRef+").getUTCFullYear(), new Date("+currentDateRef+").getUTCMonth() + 1, 1)).toISOString().slice(0, 10)")

		// Month display expressions for multiple months
		numberOfMonths := props.NumberOfMonths
		if numberOfMonths <= 0 {
			numberOfMonths = 1
		}
	}}
	if numberOfMonths == 1 {
		<!-- Single month header -->
		<div class="flex justify-center pt-1 relative items-center w-full mb-4">
			<!-- Previous month button -->
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-transparent hover:bg-accent hover:text-accent-foreground size-7 p-0 opacity-50 hover:opacity-100 absolute left-1"
				data-on-click={ prevMonthExpr }
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="m15 18-6-6 6-6"></path>
				</svg>
			</button>
			<!-- Month/Year display -->
			<div class="text-sm font-medium">
				<span data-text={ "new Date(" + currentDateRef + " + 'T12:00:00Z').toLocaleString('default', { month: 'long', year: 'numeric', timeZone: 'UTC' })" }></span>
			</div>
			<!-- Next month button -->
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-transparent hover:bg-accent hover:text-accent-foreground size-7 p-0 opacity-50 hover:opacity-100 absolute right-1"
				data-on-click={ nextMonthExpr }
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="m9 18 6-6-6-6"></path>
				</svg>
			</button>
		</div>
	} else {
		<!-- Multi-month header with navigation -->
		<div class="flex justify-between items-center w-full mb-4">
			<!-- Previous month button -->
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-transparent hover:bg-accent hover:text-accent-foreground size-7 p-0 opacity-50 hover:opacity-100"
				data-on-click={ prevMonthExpr }
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="m15 18-6-6 6-6"></path>
				</svg>
			</button>
			<!-- Month range display -->
			<div class="flex items-center space-x-1 text-sm font-medium">
				<span data-text={ "new Date(" + currentDateRef + " + 'T12:00:00Z').toLocaleString('default', { month: 'long', year: 'numeric', timeZone: 'UTC' })" }></span>
				<span>-</span>
				<span data-text={ "new Date(Date.UTC(new Date(" + currentDateRef + " + 'T12:00:00Z').getUTCFullYear(), new Date(" + currentDateRef + " + 'T12:00:00Z').getUTCMonth() + " + fmt.Sprintf("%d", numberOfMonths-1) + ", 1, 12, 0, 0)).toLocaleString('default', { month: 'long', year: 'numeric', timeZone: 'UTC' })" }></span>
			</div>
			<!-- Next month button -->
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-transparent hover:bg-accent hover:text-accent-foreground size-7 p-0 opacity-50 hover:opacity-100"
				data-on-click={ nextMonthExpr }
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
					<path d="m9 18 6-6-6-6"></path>
				</svg>
			</button>
		</div>
	}
}

// CalendarGrid renders the calendar days
templ CalendarGrid(props CalendarGridProps) {
	{{
		// Use 5 weeks (35 days) for all calendars for a cleaner, more consistent look
		weeksNeeded := 5
		totalDays := weeksNeeded * 7
	}}
	<div class="w-full border-collapse">
		<!-- Day headers -->
		<div class="grid grid-cols-7 gap-1 mb-2">
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Su</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Mo</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Tu</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">We</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Th</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Fr</div>
			<div class="text-muted-foreground rounded-md size-8 font-normal text-[0.8rem] flex items-center justify-center p-0">Sa</div>
		</div>
		<!-- Calendar days grid -->
		<div class="grid grid-cols-7 gap-1">
			<!-- Generate 35 days (5 weeks × 7 days) for cleaner layout -->
			for dayIndex := 0; dayIndex < totalDays; dayIndex++ {
				@CalendarDay(CalendarDayProps{
					ID:                 props.ID,
					DayIndex:           dayIndex,
					MonthOffset:        props.MonthOffset,
					HideOutsideDays:    props.HideOutsideDays,
					DatePickerInputsID: props.DatePickerInputsID,
				})
			}
		</div>
	</div>
}

// CalendarDay renders individual day button with pre-calculated data
templ CalendarDay(props CalendarDayProps) {
	{{
		// Calculate day information in Go instead of complex Datastar expressions
		signals := utils.Signals(props.ID, CalendarSignals{})
		
		// Pre-calculate day data using Go time package (much cleaner)
		dayData := calculateDayData(props.DayIndex, props.MonthOffset, signals.Signal("currentDate"), signals.Signal("today"))
		
		// Simple click handler for day selection
		clickHandler := signals.Set("selectedDate", fmt.Sprintf("'%s'", dayData.DateString))
		
		// CSS classes with conditional styling for today
		baseClasses := "inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 size-8 p-0 font-normal aria-selected:opacity-100 cursor-pointer hover:bg-accent hover:text-accent-foreground"
		
		// Add today styling
		todayClasses := ""
		if dayData.IsToday {
			todayClasses = " bg-accent text-accent-foreground font-semibold"
		}
		
		// Add selection styling using simple Datastar data-class
		selectionClasses := signals.Signal("selectedDate") + " === '" + dayData.DateString + "' ? 'bg-primary text-primary-foreground' : ''"
	}}
	<div class="relative p-0 text-center text-sm focus-within:relative focus-within:z-20 flex items-center justify-center">
		<button
			type="button"
			class={ baseClasses + todayClasses }
			data-class={ selectionClasses }
			data-on-click={ clickHandler }
		>
			{ fmt.Sprintf("%d", dayData.DayNumber) }
		</button>
	</div>
}
