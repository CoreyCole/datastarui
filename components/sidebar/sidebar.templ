package sidebar

import "github.com/coreycole/datastarui/utils"

// MobileMenuSignals defines the reactive state for mobile menu
type MobileMenuSignals struct {
	Open bool `json:"open"`
}

templ Sidebar(args SidebarProps) {
	{{
		// Reference the global mobile menu signals
		signals := utils.Signals("mobile_menu", MobileMenuSignals{})

		// Desktop classes - sticky sidebar (below non-modal sheets)
		desktopClasses := "border-grid fixed top-0 z-20 h-screen w-full shrink-0 border-r md:sticky md:block"

		// Mobile classes - overlay sidebar (below modal sheets, above non-modal sheets)
		mobileClasses := "md:hidden fixed inset-0 z-45 bg-background/80 backdrop-blur-sm data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0"
		sidebarContentClasses := "fixed inset-y-0 left-0 z-45 h-full w-full bg-background shadow-lg transition ease-in-out data-[state=closed]:duration-300 data-[state=open]:duration-500 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:slide-out-to-left data-[state=open]:slide-in-from-left sm:max-w-sm"
	}}
	<!-- Desktop Sidebar - only hide on mobile if mobile overlay is enabled -->
	if args.IsMobile {
		<aside class={ desktopClasses + " hidden", args.Class } { args.Attributes... }>
			<div class="no-scrollbar h-full overflow-auto pt-6 pb-6 pr-4">
				<div class="flex flex-col gap-6">
					for _, section := range args.Sections {
						<div class="flex flex-col gap-1">
							<h4 class="rounded-md px-2 py-1 text-sm font-medium">
								{ section.Title }
								if section.Label != "" {
									<span class="ml-2 rounded-md bg-[#adfa1d] px-1.5 py-0.5 text-xs leading-none text-[#000000] no-underline group-hover:no-underline">{ section.Label }</span>
								}
							</h4>
							<div class="grid grid-flow-row auto-rows-max gap-0.5 text-sm">
								for _, item := range section.Items {
									@SidebarLink(item, args.CurrentPath)
								}
							</div>
						</div>
					}
				</div>
			</div>
		</aside>
	} else {
		<aside class={ desktopClasses, args.Class } { args.Attributes... }>
			<div class="no-scrollbar h-full overflow-auto pt-6 pb-6 pr-4">
				<div class="flex flex-col gap-6">
					for _, section := range args.Sections {
						<div class="flex flex-col gap-1">
							<h4 class="rounded-md px-2 py-1 text-sm font-medium">
								{ section.Title }
								if section.Label != "" {
									<span class="ml-2 rounded-md bg-[#adfa1d] px-1.5 py-0.5 text-xs leading-none text-[#000000] no-underline group-hover:no-underline">{ section.Label }</span>
								}
							</h4>
							<div class="grid grid-flow-row auto-rows-max gap-0.5 text-sm">
								for _, item := range section.Items {
									@SidebarLink(item, args.CurrentPath)
								}
							</div>
						</div>
					}
				</div>
			</div>
		</aside>
	}
	<!-- Mobile Sidebar Overlay - only render if on mobile -->
	if args.IsMobile {
		<div
			class={ mobileClasses }
			data-show={ signals.Signal("open") }
			data-attr-data-state={ signals.Signal("open") + " ? 'open' : 'closed'" }
			data-on-click={ signals.Set("open", "false") }
			style="display: none;"
		>
			<nav
				class={ sidebarContentClasses }
				data-attr-data-state={ signals.Signal("open") + " ? 'open' : 'closed'" }
				data-on-click="evt.stopPropagation()"
			>
				<div class="flex h-14 items-center border-b px-6">
					<a class="flex items-center gap-2 font-semibold" href="/">
						<span>DatastarUI</span>
					</a>
					<button
						class="ml-auto rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none data-[state=open]:bg-secondary"
						data-on-click={ signals.Set("open", "false") }
					>
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 6 6 18"></path>
							<path d="m6 6 12 12"></path>
						</svg>
						<span class="sr-only">Close</span>
					</button>
				</div>
				<div class="no-scrollbar h-full overflow-auto pt-6 pb-6 px-4">
					<div class="flex flex-col gap-6">
						for _, section := range args.Sections {
							<div class="flex flex-col gap-1">
								<h4 class="rounded-md px-2 py-1 text-sm font-medium">
									{ section.Title }
									if section.Label != "" {
										<span class="ml-2 rounded-md bg-[#adfa1d] px-1.5 py-0.5 text-xs leading-none text-[#000000] no-underline group-hover:no-underline">{ section.Label }</span>
									}
								</h4>
								<div class="grid grid-flow-row auto-rows-max gap-0.5 text-sm">
									for _, item := range section.Items {
										@SidebarMobileLink(item, args.CurrentPath, signals)
									}
								</div>
							</div>
						}
					</div>
				</div>
			</nav>
		</div>
	}
}

templ SidebarLink(item SidebarItem, currentPath string) {
	{{
	isActive := item.Href == currentPath
	linkClasses := "group relative flex h-8 w-full items-center rounded-lg px-2 after:absolute after:inset-x-0 after:inset-y-[-2px] after:rounded-lg hover:bg-accent hover:text-accent-foreground"
	if isActive {
		linkClasses = utils.TwMerge(linkClasses, "bg-accent font-medium text-accent-foreground")
	} else {
		linkClasses = utils.TwMerge(linkClasses, "font-normal text-foreground")
	}
	}}
	<a
		class={ linkClasses }
		href={ templ.SafeURL(item.Href) }
		target=""
		rel=""
	>
		{ item.Title }
		if item.Label != "" {
			<span class="ml-2 rounded-md bg-[#adfa1d] px-1.5 py-0.5 text-xs leading-none text-[#000000] no-underline group-hover:no-underline">{ item.Label }</span>
		}
	</a>
}

templ SidebarMobileLink(item SidebarItem, currentPath string, signals *utils.SignalManager) {
	{{
	isActive := item.Href == currentPath
	linkClasses := "group relative flex h-8 w-full items-center rounded-lg px-2 after:absolute after:inset-x-0 after:inset-y-[-2px] after:rounded-lg hover:bg-accent hover:text-accent-foreground"
	if isActive {
		linkClasses = utils.TwMerge(linkClasses, "bg-accent font-medium text-accent-foreground")
	} else {
		linkClasses = utils.TwMerge(linkClasses, "font-normal text-foreground")
	}
	}}
	<a
		class={ linkClasses }
		href={ templ.SafeURL(item.Href) }
		target=""
		rel=""
		data-on-click={ signals.Set("open", "false") }
	>
		{ item.Title }
		if item.Label != "" {
			<span class="ml-2 rounded-md bg-[#adfa1d] px-1.5 py-0.5 text-xs leading-none text-[#000000] no-underline group-hover:no-underline">{ item.Label }</span>
		}
	</a>
}

// MobileMenuToggle renders the hamburger menu button
templ MobileMenuToggle(isMobile bool) {
	if isMobile {
		{{
			// Reference the same mobile menu signals
			signals := utils.Signals("mobile_menu", MobileMenuSignals{})
		}}
		<button
			class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground text-foreground h-8 w-8 px-0"
			data-on-click={ signals.Set("open", "true") }
		>
			<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="4" x2="20" y1="12" y2="12"></line>
				<line x1="4" x2="20" y1="6" y2="6"></line>
				<line x1="4" x2="20" y1="18" y2="18"></line>
			</svg>
			<span class="sr-only">Toggle menu</span>
		</button>
	}
}
