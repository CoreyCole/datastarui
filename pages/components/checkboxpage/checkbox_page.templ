package checkboxpage

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/checkbox"
	"github.com/coreycole/datastarui/components/form"
	"github.com/coreycole/datastarui/components/input"
	"github.com/coreycole/datastarui/components/label"
	"github.com/coreycole/datastarui/components/tooltip"
	l "github.com/coreycole/datastarui/layouts"
	"github.com/coreycole/datastarui/utils"
)

templ CheckboxPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8">
			@l.ComponentPageBreadcrumbs("Checkbox")
			<!-- Page Header -->
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Checkbox</h1>
				<p class="text-lg text-muted-foreground">
					A control that allows the user to toggle between checked and not checked.
				</p>
			</div>
			<!-- Component Grid -->
			<div class="grid gap-8">
				<!-- Basic Checkbox -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Basic Checkbox
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A simple checkbox with state display.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="flex items-center gap-3">
							@checkbox.Checkbox(checkbox.CheckboxArgs{
								ID: "terms",
							})
							@label.Label(label.LabelArgs{
								For: "terms",
							}) {
								Accept terms and conditions
							}
						</div>
						<div class="mt-2 p-3 bg-muted rounded-lg max-w-sm">
							<p class="text-sm">
								<strong>State:</strong>
								<span data-text="$terms.checked ? 'Accepted' : 'Not accepted'"></span>
							</p>
						</div>
					}
				}
				<!-- Checked by Default -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Checked by Default
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A checkbox that starts in the checked state with additional description.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="flex flex-row items-start gap-3">
							@checkbox.Checkbox(checkbox.CheckboxArgs{
								ID:      "terms_2",
								Checked: true,
							}) {
								<div class="grid gap-2">
									@label.Label(label.LabelArgs{
										For: "terms_2",
									}) {
										Accept terms and conditions
									}
									<p class="text-sm text-muted-foreground">
										You agree to our Terms of Service and Privacy Policy.
									</p>
								</div>
							}
						</div>
						<div class="mt-2 p-3 bg-muted rounded-lg max-w-sm">
							<p class="text-sm">
								<strong>State:</strong>
								<span data-text="$terms_2.checked ? 'Accepted' : 'Not accepted'"></span>
							</p>
						</div>
					}
				}
				<!-- Disabled Checkbox with Reason -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Disabled with Tooltip
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A disabled checkbox that shows a tooltip explaining why it's disabled.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						@tooltip.TooltipTrigger(tooltip.TooltipTriggerArgs{
								TooltipID:  "premium_tooltip",
								AnchorName: "premium_tooltip_anchor",
								Class:      "cursor-not-allowed",
							}) {
								<div class="flex items-start gap-3">
									@checkbox.Checkbox(checkbox.CheckboxArgs{
										ID:       "premium",
										Disabled: true,
									})
									@label.Label(label.LabelArgs{
										For: "premium",
									}) {
										Enable advanced features
									}
								</div>
							}
							@tooltip.TooltipContent(tooltip.TooltipContentArgs{
								ID:         "premium_tooltip",
								UseAnchor:  true,
								AnchorName: "premium_tooltip_anchor",
								Side:       utils.AnchorSideTop,
								Align:      utils.AnchorAlignCenter,
						}) {
							<p class="whitespace-nowrap">This feature requires a premium account</p>
						}
						<div class="mt-2 p-3 bg-muted rounded-lg max-w-sm">
							<p class="text-sm">
								<strong>State:</strong>
								<span data-text="$premium.checked ? 'Enabled' : 'Disabled'"></span>
								<span class="text-muted-foreground ml-2">(requires premium)</span>
							</p>
						</div>
					}
				}
				<!-- Custom Styled Checkbox -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Custom Styled
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A checkbox with custom styling and hover effects.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						@label.Label(label.LabelArgs{
							Class: "max-w-sm hover:bg-accent/50 flex items-start gap-3 rounded-lg border p-3 has-[[aria-checked=true]]:border-blue-600 has-[[aria-checked=true]]:bg-blue-50 dark:has-[[aria-checked=true]]:border-blue-900 dark:has-[[aria-checked=true]]:bg-blue-950",
						}) {
							@checkbox.Checkbox(checkbox.CheckboxArgs{
								ID:        "toggle_2",
								Checked:   true,
								ClassName: "data-[state=checked]:border-blue-600 max-w-sm data-[state=checked]:bg-blue-600 data-[state=checked]:text-white dark:data-[state=checked]:border-blue-700 dark:data-[state=checked]:bg-blue-700",
							})
							<div class="flex flex-col gap-2 font-normal">
								<p class="text-sm leading-none font-medium">
									Enable notifications
								</p>
								<p class="text-muted-foreground text-sm">
									You can enable or disable notifications at any time.
								</p>
							</div>
						}
						<div class="mt-2 p-3 bg-muted rounded-lg max-w-sm">
							<p class="text-sm">
								<strong>State:</strong>
								<span data-text="$toggle_2.checked ? 'Enabled' : 'Disabled'"></span>
							</p>
						</div>
					}
				}
				<!-- Multiple Checkboxes -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Multiple Checkboxes
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Multiple checkboxes using form state management.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<form class="space-y-4">
							<div class="space-y-3">
								<div class="flex items-center gap-3">
									@checkbox.Checkbox(checkbox.CheckboxArgs{
										ID:   "newsletter",
										Name: "newsletter",
									})
									@label.Label(label.LabelArgs{
										For: "newsletter",
									}) {
										Newsletter
									}
								</div>
								<div class="flex items-center gap-3">
									@checkbox.Checkbox(checkbox.CheckboxArgs{
										ID:      "updates",
										Name:    "updates",
										Checked: true,
									})
									@label.Label(label.LabelArgs{
										For: "updates",
									}) {
										Product updates
									}
								</div>
								<div class="flex items-center gap-3">
									@checkbox.Checkbox(checkbox.CheckboxArgs{
										ID:   "marketing",
										Name: "marketing",
									})
									@label.Label(label.LabelArgs{
										For: "marketing",
									}) {
										Marketing emails
									}
								</div>
							</div>
							<div class="mt-4 p-4 bg-muted rounded-lg max-w-sm">
								<p class="text-sm font-medium mb-2">Selected preferences:</p>
								<ul class="text-sm space-y-1">
									<li data-show="$newsletter.checked">✓ Newsletter</li>
									<li data-show="$updates.checked">✓ Product updates</li>
									<li data-show="$marketing.checked">✓ Marketing emails</li>
									<li data-show="!$newsletter.checked && !$updates.checked && !$marketing.checked" class="text-muted-foreground">
										None selected
									</li>
								</ul>
							</div>
						</form>
					}
				}
				<!-- Form Example -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Form Example
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A complete form with checkbox validation and submission.
						}
					}
					@card.CardContent(card.CardContentArgs{Class: "max-w-sm"}) {
						@card.Card(card.CardArgs{}) {
							@card.CardHeader(card.CardHeaderArgs{}) {
								@card.CardTitle(card.CardTitleArgs{}) {
									Create Account
								}
								@card.CardDescription(card.CardDescriptionArgs{}) {
									Enter your information to create an account.
								}
							}
							@card.CardContent(card.CardContentArgs{}) {
								<!-- Error/Success message placeholder -->
								<div id="checkbox_form_errors"></div>
								@form.Form(form.FormArgs{
									ID:     "checkbox_form",
									Action: "/forms/checkbox-demo",
									Class:  "space-y-4",
									Attributes: templ.Attributes{
										"data-indicator-fetching": "",
									},
								}) {
									@form.FormItem(form.FormItemArgs{}) {
										@form.FormLabel(form.FormLabelArgs{For: "name"}) {
											Name
										}
										@input.Input(input.InputArgs{
											ID:          "name",
											Name:        "name",
											Placeholder: "Enter your name",
											Required:    true,
										})
									}
									@form.FormItem(form.FormItemArgs{}) {
										@form.FormLabel(form.FormLabelArgs{For: "email"}) {
											Email
										}
										@input.Input(input.InputArgs{
											ID:          "email",
											Name:        "email",
											Type:        "email",
											Placeholder: "Enter your email",
											Required:    true,
										})
									}
									@form.FormItem(form.FormItemArgs{}) {
										<div class="flex items-center gap-3">
											@checkbox.Checkbox(checkbox.CheckboxArgs{
												ID:       "terms_form",
												Name:     "terms_form",
												Required: true,
											})
											@form.FormLabel(form.FormLabelArgs{
												For:   "terms_form",
												Class: "text-sm font-normal",
											}) {
												I agree to the 
												<a href="#" class="underline underline-offset-4 hover:text-primary">
													terms and conditions
												</a>
											}
										</div>
									}
									<div class="flex items-center gap-2">
										@button.Button(button.ButtonArgs{
											Type: "submit",
											Attributes: templ.Attributes{
												"data-attr-disabled": "$fetching",
												"data-text":          "$fetching ? 'Creating...' : 'Create Account'",
											},
										}) {
											Create Account
										}
										<div class="loading loading-spinner loading-sm text-primary" data-show="$fetching"></div>
									</div>
								}
							}
						}
					}
				}
			</div>
		</div>
	}
}
