package dropdownpage

import (
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/dropdown"
	selectcomponent "github.com/coreycole/datastarui/components/select"
	l "github.com/coreycole/datastarui/layouts"
)

templ DropdownPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8 pb-32">
			@l.ComponentPageBreadcrumbs("Dropdown")
			<!-- Page Header -->
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Dropdown Menu</h1>
				<p class="text-lg text-muted-foreground">
					Displays a menu to the user — such as a set of actions or functions — triggered by a button.
				</p>
			</div>
			<!-- Component Grid -->
			<div class="grid gap-8">
				<!-- Basic Dropdown -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Basic Dropdown
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A simple dropdown menu with various menu items.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="inline-block">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "basic-dropdown"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "basic-dropdown",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Open Menu
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "basic-dropdown",
									Align: "start",
								}) {
									@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
										ID: "basic-dropdown",
									}) {
										My Account
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "basic-dropdown",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "basic-dropdown",
									}) {
										Profile
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "basic-dropdown",
									}) {
										Billing
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "basic-dropdown",
									}) {
										Team
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "basic-dropdown",
									}) {
										Subscription
									}
								}
							}
						</div>
					}
				}
				<!-- Typed Link/Form/Custom Items -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Typed Link/Form/Custom Items
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Real anchors, forms, and flow-content containers for action menus.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="inline-block">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "typed_actions_dropdown"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "typed_actions_dropdown",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Actions
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{ID: "typed_actions_dropdown", Align: "start"}) {
									@dropdown.DropdownMenuLinkItem(dropdown.DropdownMenuLinkItemArgs{ID: "typed_actions_dropdown", Href: "/docs", Target: "_blank", Rel: "noreferrer"}) {
										Open docs
									}
									@dropdown.DropdownMenuFormItem(dropdown.DropdownMenuFormItemArgs{ID: "typed_actions_dropdown", Action: "/examples/action", Method: "post"}) {
										Run action
									}
									@dropdown.DropdownMenuCustomItem(dropdown.DropdownMenuCustomItemArgs{ID: "typed_actions_dropdown", Class: "block"}) {
										<details>
											<summary class="cursor-pointer text-xs">Confirm custom action</summary>
											<p class="mt-2 text-xs text-muted-foreground">Custom item can host flow content without a span wrapper.</p>
										</details>
									}
								}
							}
						</div>
					}
				}
				<!-- Dropdown with Icons and Shortcuts -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							With Icons and Shortcuts
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Dropdown menu items with icons and keyboard shortcuts.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="inline-block">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "icons-dropdown"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "icons-dropdown",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Open Menu
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "icons-dropdown",
									Align: "start",
								}) {
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "icons-dropdown",
									}) {
										<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
										</svg>
										Profile
										@dropdown.DropdownMenuShortcut(dropdown.DropdownMenuShortcutArgs{
											ID: "icons-dropdown",
										}) {
											⇧⌘P
										}
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "icons-dropdown",
									}) {
										<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
										</svg>
										Billing
										@dropdown.DropdownMenuShortcut(dropdown.DropdownMenuShortcutArgs{
											ID: "icons-dropdown",
										}) {
											⌘B
										}
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "icons-dropdown",
									}) {
										<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
										</svg>
										Settings
										@dropdown.DropdownMenuShortcut(dropdown.DropdownMenuShortcutArgs{
											ID: "icons-dropdown",
										}) {
											⌘S
										}
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "icons-dropdown",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID:      "icons-dropdown",
										Variant: "destructive",
									}) {
										<svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
										</svg>
										Log out
										@dropdown.DropdownMenuShortcut(dropdown.DropdownMenuShortcutArgs{
											ID: "icons-dropdown",
										}) {
											⇧⌘Q
										}
									}
								}
							}
						</div>
					}
				}
				<!-- Grouped Dropdown -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Grouped Items
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Dropdown menu with grouped items and labels.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="inline-block">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "grouped-dropdown"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "grouped-dropdown",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Open Menu
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "grouped-dropdown",
									Align: "start",
								}) {
									@dropdown.DropdownMenuGroup(dropdown.DropdownMenuGroupArgs{
										ID: "grouped-dropdown",
									}) {
										@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
											ID: "grouped-dropdown",
										}) {
											Personal
										}
										@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
											ID: "grouped-dropdown",
										}) {
											Profile
										}
										@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
											ID: "grouped-dropdown",
										}) {
											Settings
										}
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "grouped-dropdown",
									})
									@dropdown.DropdownMenuGroup(dropdown.DropdownMenuGroupArgs{
										ID: "grouped-dropdown",
									}) {
										@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
											ID: "grouped-dropdown",
										}) {
											Team
										}
										@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
											ID: "grouped-dropdown",
										}) {
											Team Settings
										}
										@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
											ID: "grouped-dropdown",
										}) {
											Invite Users
										}
									}
								}
							}
						</div>
					}
				}
				<!-- Dropdown with Select (Overflow Test) -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Dropdown with Select
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Test that a select component inside a dropdown doesn't get clipped when it extends below the dropdown's edge.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div class="inline-block">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "select_dropdown"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "select_dropdown",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Open Dropdown with Select
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "select_dropdown",
									Align: "start",
								}) {
									@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
										ID: "select_dropdown",
									}) {
										Select an Option
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "select_dropdown",
									})
									<div class="px-2 py-2">
										@selectcomponent.Select(selectcomponent.SelectArgs{
											ID:          "dropdown_select",
											Placeholder: "Choose a framework",
											Options: []selectcomponent.SelectOptionArgs{
												{Value: "next", Label: "Next.js"},
												{Value: "react", Label: "React"},
												{Value: "vue", Label: "Vue"},
												{Value: "svelte", Label: "Svelte"},
												{Value: "angular", Label: "Angular"},
												{Value: "solid", Label: "Solid"},
												{Value: "qwik", Label: "Qwik"},
												{Value: "astro", Label: "Astro"},
											},
										})
									</div>
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "select_dropdown",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "select_dropdown",
									}) {
										Close
									}
								}
							}
						</div>
						<p class="mt-4 text-sm text-muted-foreground">
							The select options should extend below the dropdown edge without being clipped.
						</p>
					}
				}
				<!-- Multiple Dropdowns Test -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Multiple Dropdowns
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Test that multiple dropdowns work independently with namespaced signals.
						}
					}
					@card.CardContent(card.CardContentArgs{Class: "space-y-4"}) {
						<div class="flex gap-4">
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "test-dropdown-1"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "test-dropdown-1",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Dropdown 1
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "test-dropdown-1",
									Align: "start",
								}) {
									@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
										ID: "test-dropdown-1",
									}) {
										First Menu
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "test-dropdown-1",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-1",
									}) {
										Option 1A
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-1",
									}) {
										Option 1B
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-1",
									}) {
										Option 1C
									}
								}
							}
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "test-dropdown-2"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "test-dropdown-2",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Dropdown 2
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "test-dropdown-2",
									Align: "start",
								}) {
									@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
										ID: "test-dropdown-2",
									}) {
										Second Menu
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "test-dropdown-2",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-2",
									}) {
										Option 2A
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-2",
									}) {
										Option 2B
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-2",
									}) {
										Option 2C
									}
								}
							}
							@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "test-dropdown-3"}) {
								@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
									ID:    "test-dropdown-3",
									Class: "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-xs hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2",
								}) {
									Dropdown 3
								}
								@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
									ID:    "test-dropdown-3",
									Align: "start",
								}) {
									@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
										ID: "test-dropdown-3",
									}) {
										Third Menu
									}
									@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
										ID: "test-dropdown-3",
									})
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-3",
									}) {
										Option 3A
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-3",
									}) {
										Option 3B
									}
									@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
										ID: "test-dropdown-3",
									}) {
										Option 3C
									}
								}
							}
						</div>
						<p class="text-sm text-muted-foreground">
							Each dropdown should open and close independently. Before the fix, all dropdowns would open/close together.
						</p>
					}
				}
			</div>
			<!-- Nested Dropdown/Select Test (User Profile Scenario) -->
			@card.Card(card.CardArgs{}) {
				@card.CardHeader(card.CardHeaderArgs{}) {
					@card.CardTitle(card.CardTitleArgs{}) {
						Nested Dropdown + Select (User Profile)
					}
					@card.CardDescription(card.CardDescriptionArgs{}) {
						Test that a select component inside a dropdown menu doesn't close the dropdown when interacted with. This reproduces the user profile menu scenario.
					}
				}
				@card.CardContent(card.CardContentArgs{}) {
					<div class="inline-block">
						@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "user_profile_test"}) {
							@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
								ID:    "user_profile_test",
								Class: "h-8 w-8 rounded-full p-0 inline-flex items-center justify-center bg-primary text-primary-foreground",
							}) {
								U
							}
							@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
								ID:    "user_profile_test",
								Align: "start",
							}) {
								@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
									ID: "user_profile_test",
								}) {
									user@example.com
								}
								@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
									ID: "user_profile_test",
								}) {
									<div class="flex items-center gap-2 py-2">
										<span class="text-sm text-muted-foreground whitespace-nowrap">Theme:</span>
										@selectcomponent.Select(selectcomponent.SelectArgs{
											ID:          "nested_theme_select",
											Placeholder: "Select theme",
											Options: []selectcomponent.SelectOptionArgs{
												{Value: "monokai", Label: "Monokai"},
												{Value: "dracula", Label: "Dracula"},
												{Value: "github", Label: "GitHub"},
												{Value: "nord", Label: "Nord"},
											},
										})
									</div>
								}
								@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
									ID: "user_profile_test",
								})
								@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
									ID:      "user_profile_test",
									Variant: "destructive",
								}) {
									Log out
								}
							}
						}
					</div>
				}
			}
			<!-- Manual Composition Select (Syntax Theme Repro) -->
			@card.Card(card.CardArgs{}) {
				@card.CardHeader(card.CardHeaderArgs{}) {
					@card.CardTitle(card.CardTitleArgs{}) {
						Manual Composition Select (Syntax Theme Repro)
					}
					@card.CardDescription(card.CardDescriptionArgs{}) {
						Reproducing the exact syntax theme selector structure to test if manual composition causes the dropdown to close.
					}
				}
				@card.CardContent(card.CardContentArgs{}) {
					<div class="inline-block">
						@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: "manual_composition_test"}) {
							@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
								ID:    "manual_composition_test",
								Class: "h-8 w-8 rounded-full p-0 inline-flex items-center justify-center bg-primary text-primary-foreground",
							}) {
								U
							}
							@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
								ID:    "manual_composition_test",
								Align: "start",
							}) {
								@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
									ID: "manual_composition_test",
								}) {
									user@example.com
								}
								@dropdown.DropdownMenuLabel(dropdown.DropdownMenuLabelArgs{
									ID: "manual_composition_test",
								}) {
									<!-- Exact structure from syntax theme selector -->
									<div class="flex items-center gap-2">
										<span class="text-sm text-muted-foreground whitespace-nowrap">Syntax:</span>
										@selectcomponent.Select(selectcomponent.SelectArgs{
											ID:          "manual_syntax_select",
											Placeholder: "Select theme",
											Class:       "w-[180px]",
										}) {
											@selectcomponent.SelectTrigger(selectcomponent.SelectTriggerArgs{
												ID: "manual_syntax_select",
											}) {
												@selectcomponent.SelectValue(selectcomponent.SelectValueArgs{
													ID:          "manual_syntax_select",
													Placeholder: "Select theme",
												})
											}
											@selectcomponent.SelectContent(selectcomponent.SelectContentArgs{
												ID:    "manual_syntax_select",
												Class: "max-h-[300px]",
											}) {
												@selectcomponent.SelectGroup(selectcomponent.SelectGroupArgs{}) {
													@selectcomponent.SelectLabel(selectcomponent.SelectLabelArgs{}) {
														Dark Themes
													}
													@selectcomponent.SelectItem(selectcomponent.SelectItemArgs{
														ID:    "manual_syntax_select",
														Value: "monokai",
														Index: 0,
													}) {
														Monokai
													}
													@selectcomponent.SelectItem(selectcomponent.SelectItemArgs{
														ID:    "manual_syntax_select",
														Value: "dracula",
														Index: 1,
													}) {
														Dracula
													}
													@selectcomponent.SelectItem(selectcomponent.SelectItemArgs{
														ID:    "manual_syntax_select",
														Value: "nord",
														Index: 2,
													}) {
														Nord
													}
												}
												@selectcomponent.SelectSeparator(selectcomponent.SelectSeparatorArgs{})
												@selectcomponent.SelectGroup(selectcomponent.SelectGroupArgs{}) {
													@selectcomponent.SelectLabel(selectcomponent.SelectLabelArgs{}) {
														Light Themes
													}
													@selectcomponent.SelectItem(selectcomponent.SelectItemArgs{
														ID:    "manual_syntax_select",
														Value: "github",
														Index: 3,
													}) {
														GitHub
													}
													@selectcomponent.SelectItem(selectcomponent.SelectItemArgs{
														ID:    "manual_syntax_select",
														Value: "solarized-light",
														Index: 4,
													}) {
														Solarized Light
													}
												}
											}
										}
									</div>
								}
								@dropdown.DropdownMenuSeparator(dropdown.DropdownMenuSeparatorArgs{
									ID: "manual_composition_test",
								})
								@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
									ID:      "manual_composition_test",
									Variant: "destructive",
								}) {
									Log out
								}
							}
						}
					</div>
					<p class="mt-4 text-sm text-muted-foreground">
						This test case uses manual Select composition (SelectTrigger/SelectContent/SelectGroup) exactly like the syntax theme selector.
						If this fails the same way, it confirms the issue is in the manual composition pattern, not the SyntaxThemeSelector component.
					</p>
				}
			}
		</div>
	}
}
