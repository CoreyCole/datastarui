package datepickerpage

import (
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/datepicker"
	"github.com/coreycole/datastarui/components/label"
	l "github.com/coreycole/datastarui/layouts"
)

templ Page(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8">
			@l.ComponentPageBreadcrumbs("Datepicker")
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Datepicker</h1>
				<p class="text-muted-foreground">Test bidirectional signal coordination between date inputs and calendar components.</p>
			</div>
			<div class="space-y-12">
				<!-- Combined DatePicker Testing Section -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DatePicker Components</h2>
					<div class="space-y-8">
						<!-- Single Date Picker -->
						@card.Card(card.CardArgs{Class: "w-fit mb-6"}) {
							@card.CardHeader(card.CardHeaderArgs{}) {
								@card.CardTitle(card.CardTitleArgs{}) {
									Single Date Picker
								}
								@card.CardDescription(card.CardDescriptionArgs{}) {
									Basic date picker with input field and calendar popover
								}
							}
							@card.CardContent(card.CardContentArgs{}) {
								<div class="space-y-4">
									@label.Label(label.LabelArgs{For: "single_date"}) {
										Select Date
									}
									@datepicker.DatePicker(datepicker.DatePickerArgs{
										ID:   "single_date",
										Name: "singleDate",
										Mode: "single",
									})
								</div>
							}
						}
						<!-- Range Date Picker -->
						@card.Card(card.CardArgs{Class: "w-fit"}) {
							@card.CardHeader(card.CardHeaderArgs{}) {
								@card.CardTitle(card.CardTitleArgs{}) {
									Date Range Picker
								}
								@card.CardDescription(card.CardDescriptionArgs{}) {
									Range picker with dual inputs and two-month calendar view
								}
							}
							@card.CardContent(card.CardContentArgs{}) {
								<div class="space-y-4">
									@label.Label(label.LabelArgs{For: "range_date"}) {
										Select Date Range
									}
									@datepicker.DatePicker(datepicker.DatePickerArgs{
										ID:              "range_date",
										Name:            "dateRange",
										Mode:            "range",
										OpenOnFocus:     true,
										PopoverPosition: "top",
										Placeholder:     "Select date range...",
										NumberOfMonths:  2,
									})
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
}
