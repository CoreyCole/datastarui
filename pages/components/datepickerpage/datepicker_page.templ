package datepickerpage

import (
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/dateinput"
	"github.com/coreycole/datastarui/components/datepicker"
	"github.com/coreycole/datastarui/components/label"
	l "github.com/coreycole/datastarui/layouts"
)

templ Page() {
	@l.Root("components") {
		<div class="container mx-auto p-4">
			<h1 class="text-3xl font-bold mb-6">DatePicker & DateInput Components</h1>
			<p class="text-muted-foreground mb-8">Smart date input components with auto-formatting and calendar integration.</p>
			<div class="space-y-12">
				<!-- NEW: DateInput Component Demo -->
				<!-- Test: Live reload working! -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DateInput Component</h2>
					<p class="text-sm text-muted-foreground mb-4">
						A smart date input with automatic slash insertion and year completion. Type numbers and see the magic!
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-6">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "date-input-basic"}) {
											Basic Date Input
										}
										@dateinput.DateInput(dateinput.DateInputProps{
											ID:          "date-input-basic",
											Name:        "basicDate",
											Placeholder: "MM/DD/YYYY",
										})
									</div>
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "date-input-preselected"}) {
											Pre-selected Date
										}
										@dateinput.DateInput(dateinput.DateInputProps{
											ID:    "date-input-preselected",
											Name:  "preselectedDate",
											Value: "12/25/23",
										})
									</div>
								</div>
								<div class="bg-muted/50 p-4 rounded-lg">
									<h4 class="font-medium mb-2">✨ Features to Test:</h4>
									<div class="text-sm text-muted-foreground space-y-1">
										<p>• <strong>Auto-formatting:</strong> Type <code>12252024</code> → becomes <code>12/25/2024</code></p>
										<p>• <strong>Year completion:</strong> Type <code>12/25/24</code> then tab/click away → becomes <code>12/25/2024</code></p>
										<p>• <strong>Input validation:</strong> Only numbers and navigation keys allowed</p>
										<p>• <strong>Dual signals:</strong> See both display format and ISO date format below</p>
									</div>
								</div>
							</div>
						}
					}
				</div>
				<!-- NEW: DateInput Range Mode Demo -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DateInput Range Mode</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Range date inputs with optional end dates and smart tab-triggered formatting.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-8">
								<!-- Basic Date Range -->
								<div class="space-y-2">
									<h4 class="font-medium">Basic Date Range</h4>
									@label.Label(label.LabelProps{}) {
										Project Timeline
									}
									@dateinput.DateInput(dateinput.DateInputProps{
										ID:   "basic-range",
										Name: "projectTimeline",
										Mode: "range",
									})
								</div>
								<!-- Optional End Date Range -->
								<div class="space-y-2">
									<h4 class="font-medium">Optional End Date Range</h4>
									<p class="text-xs text-muted-foreground mb-2">
										Features the "Set an end date" checkbox from your mockup
									</p>
									@dateinput.DateInput(dateinput.DateInputProps{
										ID:              "optional-range",
										Name:            "optionalTimeline",
										Mode:            "range",
										EndDateOptional: true,
									})
								</div>
								<!-- Pre-filled Range -->
								<div class="space-y-2">
									<h4 class="font-medium">Pre-filled Date Range</h4>
									@dateinput.DateInput(dateinput.DateInputProps{
										ID:         "prefilled-range",
										Name:       "prefilledTimeline",
										Mode:       "range",
										StartValue: "02/01/24",
										EndValue:   "02/28/24",
									})
								</div>
								<!-- Vertical Layout -->
								<div class="space-y-2">
									<h4 class="font-medium">Vertical Layout</h4>
									@dateinput.DateInput(dateinput.DateInputProps{
										ID:          "vertical-range",
										Name:        "verticalTimeline",
										Mode:        "range",
										Orientation: "vertical",
									})
								</div>
								<!-- Features to test -->
								<div class="bg-muted/50 p-4 rounded-lg">
									<h4 class="font-medium mb-2">🚀 Range Features to Test:</h4>
									<div class="text-sm text-muted-foreground space-y-1">
										<p>• <strong>Tab completion:</strong> Type <code>12/25/25</code> in start date, then press Tab → becomes <code>12/25/2025</code></p>
										<p>• <strong>Optional checkbox:</strong> Check/uncheck "Set an end date" to see dynamic behavior</p>
										<p>• <strong>Auto-focus:</strong> When checkbox is checked, focus moves to end date</p>
										<p>• <strong>Form submission:</strong> Two separate hidden inputs are created for each range</p>
										<p>• <strong>Individual formatting:</strong> Both inputs format independently as you type</p>
									</div>
								</div>
							</div>
						}
					}
				</div>
				<!-- Basic Single Date Picker -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DatePicker: Basic Single Date</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Complete date picker with input field and calendar popover. Features smart input with auto-slash insertion.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-4">
								@label.Label(label.LabelProps{For: "basic_date"}) {
									Select Date
								}
								@datepicker.DatePicker(datepicker.DatePickerProps{
									ID:   "basic_date",
									Name: "basicDate",
									Mode: "single",
								})
							</div>
						}
					}
				</div>
				<!-- Range Date Picker -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">Date Range Picker</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Select a date range with a two-month calendar view for better range selection.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-4">
								@label.Label(label.LabelProps{For: "range_date"}) {
									Select Date Range
								}
								@datepicker.DatePicker(datepicker.DatePickerProps{
									ID:                 "range_date",
									Name:               "dateRange",
									Mode:               "range",
									OpenOnFocus:        true,
									PopoverPosition:    "top",
									Placeholder:        "Select date range...",
									NumberOfMonths:     2,
									CalendarID:         "range_date_calendar",
									DatePickerInputsID: "range_date_dateinput",
								})
							</div>
						}
					}
				</div>
			</div>
		</div>
	}
}
