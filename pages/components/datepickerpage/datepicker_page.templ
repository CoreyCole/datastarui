package datepickerpage

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/dateinput"
	"github.com/coreycole/datastarui/components/datepicker"
	"github.com/coreycole/datastarui/components/form"
	"github.com/coreycole/datastarui/components/label"
	l "github.com/coreycole/datastarui/layouts"
)

templ Page() {
	@l.Root("components") {
		<div class="container mx-auto p-4">
			<h1 class="text-3xl font-bold mb-6">DatePicker & DateInput Components</h1>
			<p class="text-muted-foreground mb-8">Smart date input components with auto-formatting and calendar integration.</p>
			<div class="space-y-12">
				<!-- NEW: DateInput Component Demo -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DateInput Component</h2>
					<p class="text-sm text-muted-foreground mb-4">
						A smart date input with automatic slash insertion and year completion. Type numbers and see the magic!
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-6">
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "date-input-basic"}) {
											Basic Date Input
										}
										@dateinput.DateInput(dateinput.DateInputProps{
											ID:          "date-input-basic",
											Name:        "basicDate",
											Placeholder: "MM/DD/YYYY",
										})
									</div>
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "date-input-preselected"}) {
											Pre-selected Date
										}
										@dateinput.DateInput(dateinput.DateInputProps{
											ID:    "date-input-preselected",
											Name:  "preselectedDate",
											Value: "12/25/23",
										})
									</div>
								</div>
								<div class="bg-muted/50 p-4 rounded-lg">
									<h4 class="font-medium mb-2">✨ Features to Test:</h4>
									<div class="text-sm text-muted-foreground space-y-1">
										<p>• <strong>Auto-formatting:</strong> Type <code>12252024</code> → becomes <code>12/25/2024</code></p>
										<p>• <strong>Year completion:</strong> Type <code>12/25/24</code> then tab/click away → becomes <code>12/25/2024</code></p>
										<p>• <strong>Input validation:</strong> Only numbers and navigation keys allowed</p>
										<p>• <strong>Dual signals:</strong> See both display format and ISO date format below</p>
									</div>
								</div>
							</div>
						}
					}
				</div>
				<!-- Basic Single Date Picker -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">DatePicker: Basic Single Date</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Complete date picker with input field and calendar popover. Features smart input with auto-slash insertion.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-4">
								@label.Label(label.LabelProps{For: "basic-date"}) {
									Select Date
								}
								@datepicker.DatePicker(datepicker.DatePickerProps{
									ID:   "basic-date",
									Name: "basicDate",
									Mode: "single",
								})
								<p class="text-xs text-muted-foreground">
									💡 Try typing: 20241225, 2024/12/25, or 24/12/25
								</p>
							</div>
						}
					}
				</div>
				<!-- Range Date Picker -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">Date Range Picker</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Select a date range with a two-month calendar view for better range selection.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-4">
								@label.Label(label.LabelProps{For: "range-date"}) {
									Select Date Range
								}
								@datepicker.DatePicker(datepicker.DatePickerProps{
									ID:             "range-date",
									Name:           "dateRange",
									Mode:           "range",
									Placeholder:    "Select date range...",
									NumberOfMonths: 2,
								})
							</div>
						}
					}
				</div>
				<!-- Form Integration -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">Form Integration</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Date pickers integrated with form state management and validation.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							@form.Form(form.FormProps{
								ID:    "booking-form",
								Class: "space-y-6",
							}) {
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "checkin-date"}) {
											Check-in Date *
										}
										@datepicker.DatePicker(datepicker.DatePickerProps{
											ID:          "checkin-date",
											Name:        "checkinDate",
											Mode:        "single",
											Placeholder: "YYYY/MM/DD",
											Required:    true,
										})
									</div>
									<div class="space-y-2">
										@label.Label(label.LabelProps{For: "checkout-date"}) {
											Check-out Date *
										}
										@datepicker.DatePicker(datepicker.DatePickerProps{
											ID:          "checkout-date",
											Name:        "checkoutDate",
											Mode:        "single",
											Placeholder: "YYYY/MM/DD",
											Required:    true,
										})
									</div>
								</div>
								<div class="flex gap-4">
									@button.Button(button.ButtonProps{Type: "submit"}) {
										Book Reservation
									}
									@button.Button(button.ButtonProps{
										Type:    "button",
										Variant: "outline",
									}) {
										Clear Form
									}
								</div>
							}
						}
					}
				</div>
				<!-- Custom Styling -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">Custom Styling</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Date pickers with custom styling for different use cases.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div class="space-y-2">
									@label.Label(label.LabelProps{For: "compact-date"}) {
										Compact Style
									}
									@datepicker.DatePicker(datepicker.DatePickerProps{
										ID:            "compact-date",
										Name:          "compactDate",
										Mode:          "single",
										Placeholder:   "Compact",
										InputClass:    "h-8 text-sm",
										CalendarClass: "scale-90",
									})
								</div>
								<div class="space-y-2">
									@label.Label(label.LabelProps{For: "large-date"}) {
										Large Style
									}
									@datepicker.DatePicker(datepicker.DatePickerProps{
										ID:          "large-date",
										Name:        "largeDate",
										Mode:        "single",
										Placeholder: "Large size",
										InputClass:  "h-12 text-lg",
									})
								</div>
							</div>
						}
					}
				</div>
				<!-- Advanced Range with Presets -->
				<div>
					<h2 class="text-2xl font-semibold mb-4">Advanced Range Selection</h2>
					<p class="text-sm text-muted-foreground mb-4">
						Advanced range picker with pre-selected range and clean month view.
					</p>
					@card.Card(card.CardProps{Class: "w-fit"}) {
						@card.CardContent(card.CardContentProps{Class: "p-6"}) {
							<div class="space-y-4">
								@label.Label(label.LabelProps{For: "advanced-range"}) {
									Project Timeline
								}
								@datepicker.DatePicker(datepicker.DatePickerProps{
									ID:              "advanced-range",
									Name:            "projectTimeline",
									Mode:            "range",
									Placeholder:     "Select project timeline",
									RangeStart:      "2024-02-01",
									RangeEnd:        "2024-02-28",
									NumberOfMonths:  2,
									HideOutsideDays: true,
								})
							</div>
						}
					}
				</div>
			</div>
		</div>
	}
}
