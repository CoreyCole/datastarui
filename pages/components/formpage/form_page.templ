package formpage

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/form"
	"github.com/coreycole/datastarui/components/input"
	"github.com/coreycole/datastarui/components/textarea"
	l "github.com/coreycole/datastarui/layouts"
)

templ FormPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8">
			@l.ComponentPageBreadcrumbs("Form")
			<!-- Page Header -->
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Form</h1>
				<p class="text-lg text-muted-foreground">
					Building forms with validation and accessibility. Includes form fields, labels, descriptions, and error messages.
				</p>
			</div>
			<!-- Component Grid -->
			<div class="grid gap-8">
				<!-- Basic Form Example -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Basic Form
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A simple form with input validation and descriptions.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<!-- Error/Success message placeholder -->
						<div id="basic_form_errors"></div>
						@form.Form(form.FormArgs{
							ID:     "basic_form",
							Action: "/components/form/basic",
						}) {
							@form.FormItem(form.FormItemArgs{}) {
								@form.FormLabel(form.FormLabelArgs{For: "username"}) {
									Username
								}
								@input.Input(input.InputArgs{
									ID:          "username",
									Name:        "username",
									Placeholder: "shadcn",
								})
								@form.FormDescription(form.FormDescriptionArgs{}) {
									This is your public display name.
								}
								@form.FormMessage(form.FormMessageArgs{})
							}
							<div class="flex items-center gap-2">
								@button.Button(button.ButtonArgs{
									Type: "submit",
									Attributes: templ.Attributes{
										"data-attr:disabled": "$fetching",
										"data-text":          "$fetching ? 'Submitting...' : 'Submit'",
									},
								}) {
									Submit
								}
								<div class="loading loading-spinner loading-sm text-primary" data-show="$fetching"></div>
							</div>
						}
					}
				}
				<!-- Form with Validation Example -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Form with Validation
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Demonstrates form validation with error states and messages.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div>
							<!-- Error/Success message placeholder -->
							<div id="validation_form_errors"></div>
							@form.Form(form.FormArgs{
								ID:     "validation_form",
								Action: "/components/form/validation",
							}) {
								@form.FormItem(form.FormItemArgs{}) {
									@form.FormLabel(form.FormLabelArgs{For: "email"}) {
										Email
									}
									@input.Input(input.InputArgs{
										ID:          "email",
										Name:        "email",
										Type:        "email",
										Placeholder: "Enter your email",
										Attributes: templ.Attributes{
											"aria-describedby": "email_description",
										},
									})
									@form.FormDescription(form.FormDescriptionArgs{ID: "email_description"}) {
										We'll never share your email with anyone else.
									}
									@form.FormMessage(form.FormMessageArgs{}) {
									}
								}
								@form.FormItem(form.FormItemArgs{}) {
									@form.FormLabel(form.FormLabelArgs{For: "password"}) {
										Password
									}
									@input.Input(input.InputArgs{
										ID:          "password",
										Name:        "password",
										Type:        "password",
										Placeholder: "Enter your password",
										Attributes: templ.Attributes{
											"aria-describedby": "password_description",
										},
									})
									@form.FormDescription(form.FormDescriptionArgs{ID: "password_description"}) {
										Must be at least 8 characters long.
									}
									@form.FormMessage(form.FormMessageArgs{}) {
									}
								}
								<div class="flex items-center gap-2">
									@button.Button(button.ButtonArgs{
										Type: "submit",
										Attributes: templ.Attributes{
											"data-indicator-fetching": "",
											"data-attr:disabled":      "$fetching",
											"data-text":               "$fetching ? 'Submitting...' : 'Submit'",
										},
									}) {
										Submit
									}
									<div class="loading loading-spinner loading-sm text-primary" data-show="$fetching"></div>
								</div>
							}
						</div>
					}
				}
				<!-- Contact Form Example -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Contact Form
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A more complex form with multiple field types and reactive validation.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						<div data-signals="{contact: {name: '', email: '', subject: '', message: ''}}">
							<!-- Error/Success message placeholder -->
							<div id="contact_form_errors"></div>
							@form.Form(form.FormArgs{
								ID:     "contact_form",
								Action: "/components/form/contact",
							}) {
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									@form.FormItem(form.FormItemArgs{}) {
										@form.FormLabel(form.FormLabelArgs{For: "name"}) {
											Name
										}
										@input.Input(input.InputArgs{
											ID:          "name",
											Name:        "name",
											Placeholder: "Your name",
											Required:    true,
											Attributes: templ.Attributes{
												"data-bind": "$contact.name",
											},
										})
									}
									@form.FormItem(form.FormItemArgs{}) {
										@form.FormLabel(form.FormLabelArgs{For: "contact_email"}) {
											Email
										}
										@input.Input(input.InputArgs{
											ID:          "contact_email",
											Name:        "email",
											Type:        "email",
											Placeholder: "your.email@example.com",
											Required:    true,
											Attributes: templ.Attributes{
												"data-bind": "$contact.email",
											},
										})
									}
								</div>
								@form.FormItem(form.FormItemArgs{}) {
									@form.FormLabel(form.FormLabelArgs{For: "subject"}) {
										Subject
									}
									@input.Input(input.InputArgs{
										ID:          "subject",
										Name:        "subject",
										Placeholder: "What's this about?",
										Required:    true,
										Attributes: templ.Attributes{
											"data-bind": "$contact.subject",
										},
									})
								}
								@form.FormItem(form.FormItemArgs{}) {
									@form.FormLabel(form.FormLabelArgs{For: "message"}) {
										Message
									}
									@textarea.Textarea(textarea.TextareaArgs{
										ID:          "message",
										Name:        "message",
										Placeholder: "Your message...",
										Required:    true,
										Rows:        4,
										Attributes: templ.Attributes{
											"data-bind": "$contact.message",
										},
									})
									@form.FormDescription(form.FormDescriptionArgs{}) {
										Please provide as much detail as possible.
									}
								}
								<div class="flex gap-2 items-center">
									@button.Button(button.ButtonArgs{
										Type:    "submit",
										Variant: "default",
										Attributes: templ.Attributes{
											"data-attr:disabled": "$fetching",
											"data-text":          "$fetching ? 'Sending...' : 'Send Message'",
										},
									}) {
										Send Message
									}
									@button.Button(button.ButtonArgs{
										Type:    "button",
										Variant: "outline",
										Attributes: templ.Attributes{
											"data-on:click":      "$contact = {name: '', email: '', subject: '', message: ''}",
											"data-attr:disabled": "$fetching",
										},
									}) {
										Clear
									}
									<div class="loading loading-spinner loading-sm text-primary" data-show="$fetching"></div>
								</div>
							}
						</div>
					}
				}
			</div>
		</div>
	}
}
