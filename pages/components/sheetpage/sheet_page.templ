package sheetpage

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/input"
	"github.com/coreycole/datastarui/components/label"
	"github.com/coreycole/datastarui/components/sheet"
	l "github.com/coreycole/datastarui/layouts"
)

templ SheetPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8">
			@l.ComponentPageBreadcrumbs("Sheet")
			<!-- Page Header -->
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Sheet</h1>
				<p class="text-lg text-muted-foreground">
					Extends the Dialog component to display content that complements the main content of the screen.
				</p>
			</div>
			<!-- Component Grid -->
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<!-- Right Side Modal Sheet -->
				@card.Card(card.CardProps{}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Right Side Modal
						}
						@card.CardDescription(card.CardDescriptionProps{}) {
							Opens from the right side. Click outside or press Escape to close.
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						@sheet.Sheet(sheet.SheetArgs{
							ID:    "right_modal_sheet",
							Modal: true,
							Side:  "right",
						}) {
							@sheet.SheetContent(sheet.SheetContentArgs{
								SheetID: "right_modal_sheet",
							}) {
								@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
									@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
										Edit profile
									}
									@sheet.SheetDescription(sheet.SheetDescriptionArgs{}) {
										Make changes to your profile here. Click save when you're done.
									}
								}
								<div class="grid gap-4 py-4">
									<div class="grid grid-cols-4 items-center gap-4">
										@label.Label(label.LabelProps{
											For:   "name",
											Class: "text-right",
										}) {
											Name
										}
										@input.Input(input.InputArgs{
											ID:    "name",
											Value: "Pedro Duarte",
											Class: "col-span-3",
										})
									</div>
									<div class="grid grid-cols-4 items-center gap-4">
										@label.Label(label.LabelProps{
											For:   "username",
											Class: "text-right",
										}) {
											Username
										}
										@input.Input(input.InputArgs{
											ID:    "username",
											Value: "@peduarte",
											Class: "col-span-3",
										})
									</div>
								</div>
								@sheet.SheetFooter(sheet.SheetFooterArgs{}) {
									@button.Button(button.ButtonProps{
										Type: "submit",
									}) {
										Save changes
									}
								}
							}
						}
						@sheet.SheetTrigger(sheet.SheetTriggerArgs{
							SheetID: "right_modal_sheet",
							AsChild: true,
						}) {
							@button.Button(button.ButtonProps{}) {
								Open Right Sheet
							}
						}
					}
				}
				<!-- Left Side Menu Sheet -->
				@card.Card(card.CardProps{}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Left Side Menu
						}
						@card.CardDescription(card.CardDescriptionProps{}) {
							Navigation menu that slides from the left.
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						@sheet.Sheet(sheet.SheetArgs{
							ID:    "left_sheet",
							Modal: true,
							Side:  "left",
						}) {
							@sheet.SheetContent(sheet.SheetContentArgs{
								SheetID: "left_sheet",
							}) {
								@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
									@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
										Navigation Menu
									}
									@sheet.SheetDescription(sheet.SheetDescriptionArgs{}) {
										Browse through different sections of the application.
									}
								}
								<div class="py-4">
									<nav class="space-y-2">
										<a href="#" class="block py-2 px-3 rounded-md hover:bg-accent">Dashboard</a>
										<a href="#" class="block py-2 px-3 rounded-md hover:bg-accent">Profile</a>
										<a href="#" class="block py-2 px-3 rounded-md hover:bg-accent">Settings</a>
										<a href="#" class="block py-2 px-3 rounded-md hover:bg-accent">Logout</a>
									</nav>
								</div>
							}
						}
						@sheet.SheetTrigger(sheet.SheetTriggerArgs{
							SheetID: "left_sheet",
							AsChild: true,
						}) {
							@button.Button(button.ButtonProps{
								Variant: "outline",
							}) {
								Open Left Menu
							}
						}
					}
				}
				<!-- Top Notifications Sheet -->
				@card.Card(card.CardProps{}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Top Notifications
						}
						@card.CardDescription(card.CardDescriptionProps{}) {
							Notification panel that slides from the top.
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						@sheet.Sheet(sheet.SheetArgs{
							ID:    "top_sheet",
							Modal: true,
							Side:  "top",
						}) {
							@sheet.SheetContent(sheet.SheetContentArgs{
								SheetID: "top_sheet",
							}) {
								@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
									@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
										Notifications
									}
									@sheet.SheetDescription(sheet.SheetDescriptionArgs{}) {
										You have 3 unread notifications.
									}
								}
								<div class="py-4 space-y-2">
									<div class="p-3 bg-accent rounded-md">
										<p class="font-medium">New message from John</p>
										<p class="text-sm text-muted-foreground">2 minutes ago</p>
									</div>
									<div class="p-3 bg-accent rounded-md">
										<p class="font-medium">Your order has been shipped</p>
										<p class="text-sm text-muted-foreground">1 hour ago</p>
									</div>
									<div class="p-3 bg-accent rounded-md">
										<p class="font-medium">Welcome to our platform!</p>
										<p class="text-sm text-muted-foreground">2 hours ago</p>
									</div>
								</div>
							}
						}
						@sheet.SheetTrigger(sheet.SheetTriggerArgs{
							SheetID: "top_sheet",
							AsChild: true,
						}) {
							@button.Button(button.ButtonProps{
								Variant: "secondary",
							}) {
								Show Notifications
							}
						}
					}
				}
				<!-- Bottom Share Sheet -->
				@card.Card(card.CardProps{}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Bottom Share Sheet
						}
						@card.CardDescription(card.CardDescriptionProps{}) {
							Mobile-style bottom sheet for sharing options.
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						@sheet.Sheet(sheet.SheetArgs{
							ID:    "bottom_sheet",
							Modal: true,
							Side:  "bottom",
						}) {
							@sheet.SheetContent(sheet.SheetContentArgs{
								SheetID: "bottom_sheet",
							}) {
								@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
									@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
										Share Content
									}
									@sheet.SheetDescription(sheet.SheetDescriptionArgs{}) {
										Choose how you want to share this content.
									}
								}
								<div class="py-4">
									<div class="grid grid-cols-3 gap-4">
										@button.Button(button.ButtonProps{
											Variant: "ghost",
											Class:   "flex flex-col items-center gap-2 h-auto p-4",
										}) {
											<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m9.032 4.026a9.001 9.001 0 01-7.432 0m9.032-4.026A9.001 9.001 0 0112 3c-4.474 0-8.268 3.12-9.032 7.326m9.032 4.026A9.001 9.001 0 012.968 10.326m9.032 4.026c.202.404.316.86.316 1.342 0 .482-.114.938-.316 1.342"></path>
											</svg>
											<span class="text-sm">Copy Link</span>
										}
										@button.Button(button.ButtonProps{
											Variant: "ghost",
											Class:   "flex flex-col items-center gap-2 h-auto p-4",
										}) {
											<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
											</svg>
											<span class="text-sm">Email</span>
										}
										@button.Button(button.ButtonProps{
											Variant: "ghost",
											Class:   "flex flex-col items-center gap-2 h-auto p-4",
										}) {
											<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
											</svg>
											<span class="text-sm">Message</span>
										}
									</div>
								</div>
							}
						}
						@sheet.SheetTrigger(sheet.SheetTriggerArgs{
							SheetID: "bottom_sheet",
							AsChild: true,
						}) {
							@button.Button(button.ButtonProps{
								Variant: "destructive",
							}) {
								Share Content
							}
						}
					}
				}
				<!-- Non-Modal Format Sheet -->
				@card.Card(card.CardProps{}) {
					@card.CardHeader(card.CardHeaderProps{}) {
						@card.CardTitle(card.CardTitleProps{}) {
							Non-Modal Bottom Sheet
						}
						@card.CardDescription(card.CardDescriptionProps{}) {
							Format panel that slides from bottom and doesn't block interaction.
						}
					}
					@card.CardContent(card.CardContentProps{}) {
						@sheet.Sheet(sheet.SheetArgs{
							ID:    "non_modal_sheet",
							Modal: false,
							Side:  "bottom",
						}) {
							@sheet.SheetContent(sheet.SheetContentArgs{
								SheetID: "non_modal_sheet",
							}) {
								@sheet.SheetHeader(sheet.SheetHeaderArgs{}) {
									@sheet.SheetTitle(sheet.SheetTitleArgs{}) {
										Format Options
									}
									@sheet.SheetDescription(sheet.SheetDescriptionArgs{}) {
										Apply formatting while continuing to edit.
									}
								}
								<div class="py-4 space-y-4">
									<div class="space-y-2">
										<label class="text-sm font-medium">Font Size</label>
										<select class="w-full p-2 border rounded-md bg-background text-foreground">
											<option value="12">12px</option>
											<option value="14" selected>14px</option>
											<option value="16">16px</option>
											<option value="18">18px</option>
											<option value="20">20px</option>
											<option value="24">24px</option>
											<option value="32">32px</option>
											<option value="48">48px</option>
										</select>
									</div>
									<div class="space-y-2">
										<label class="text-sm font-medium">Font Weight</label>
										<div class="flex gap-2">
											@button.Button(button.ButtonProps{
												Variant: "outline",
												Size:    "sm",
											}) {
												Light
											}
											@button.Button(button.ButtonProps{
												Variant: "outline",
												Size:    "sm",
											}) {
												Regular
											}
											@button.Button(button.ButtonProps{
												Variant: "outline",
												Size:    "sm",
											}) {
												Bold
											}
										</div>
									</div>
									<div class="space-y-2">
										<label class="text-sm font-medium">Text Color</label>
										<div class="flex gap-2">
											<div class="w-8 h-8 bg-black rounded cursor-pointer hover:scale-110 transition-transform"></div>
											<div class="w-8 h-8 bg-red-500 rounded cursor-pointer hover:scale-110 transition-transform"></div>
											<div class="w-8 h-8 bg-blue-500 rounded cursor-pointer hover:scale-110 transition-transform"></div>
											<div class="w-8 h-8 bg-green-500 rounded cursor-pointer hover:scale-110 transition-transform"></div>
											<div class="w-8 h-8 bg-purple-500 rounded cursor-pointer hover:scale-110 transition-transform"></div>
											<div class="w-8 h-8 bg-orange-500 rounded cursor-pointer hover:scale-110 transition-transform"></div>
										</div>
									</div>
								</div>
							}
						}
						@sheet.SheetTrigger(sheet.SheetTriggerArgs{
							SheetID: "non_modal_sheet",
							AsChild: true,
						}) {
							@button.Button(button.ButtonProps{
								Variant: "ghost",
							}) {
								Open Format Panel
							}
						}
					}
				}
			</div>
			<!-- Additional Features Section -->
			<div class="space-y-4">
				<h2 class="text-2xl font-bold">Sheet Features</h2>
				<div class="grid gap-4 md:grid-cols-2">
					@card.Card(card.CardProps{}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{
								Class: "text-lg",
							}) {
								Modal vs Non-Modal
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							<ul class="text-sm space-y-2 text-muted-foreground">
								<li>• <strong>Modal sheets</strong> block interaction with main content</li>
								<li>• <strong>Non-modal sheets</strong> allow continued interaction</li>
								<li>• Modal sheets close when clicking outside</li>
								<li>• Non-modal sheets only close via button or Escape</li>
							</ul>
						}
					}
					@card.Card(card.CardProps{}) {
						@card.CardHeader(card.CardHeaderProps{}) {
							@card.CardTitle(card.CardTitleProps{
								Class: "text-lg",
							}) {
								Position Options
							}
						}
						@card.CardContent(card.CardContentProps{}) {
							<ul class="text-sm space-y-2 text-muted-foreground">
								<li>• <strong>Right:</strong> Default position, great for forms and details</li>
								<li>• <strong>Left:</strong> Perfect for navigation menus</li>
								<li>• <strong>Top:</strong> Ideal for notifications and alerts</li>
								<li>• <strong>Bottom:</strong> Mobile-friendly sharing and actions</li>
							</ul>
						}
					}
				</div>
			</div>
		</div>
	}
}
