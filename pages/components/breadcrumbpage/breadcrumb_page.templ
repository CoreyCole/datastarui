package breadcrumbpage

import (
	"github.com/coreycole/datastarui/components/breadcrumb"
	"github.com/coreycole/datastarui/components/card"
	"github.com/coreycole/datastarui/components/dropdown"
	l "github.com/coreycole/datastarui/layouts"
)

templ BreadcrumbPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="space-y-8">
			@l.ComponentPageBreadcrumbs("Breadcrumb")
			<!-- Page Header -->
			<div class="space-y-2">
				<h1 class="text-3xl font-bold tracking-tight">Breadcrumb</h1>
				<p class="text-lg text-muted-foreground">
					Displays the path to the current resource using a hierarchy of links.
				</p>
			</div>
			<!-- Component Grid -->
			<div class="grid gap-8">
				<!-- Basic Breadcrumb -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Basic Breadcrumb
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							A simple breadcrumb with navigation links and current page.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						@breadcrumb.Breadcrumb(breadcrumb.BreadcrumbArgs{}) {
							@breadcrumb.BreadcrumbList(breadcrumb.BreadcrumbListArgs{}) {
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/"}) {
										Home
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/components"}) {
										Components
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbPage(breadcrumb.BreadcrumbPageArgs{}) {
										Breadcrumb
									}
								}
							}
						}
					}
				}
				<!-- Breadcrumb with Ellipsis -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							With Ellipsis
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Use ellipsis to indicate collapsed breadcrumb items.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						@breadcrumb.Breadcrumb(breadcrumb.BreadcrumbArgs{}) {
							@breadcrumb.BreadcrumbList(breadcrumb.BreadcrumbListArgs{}) {
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/"}) {
										Home
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbEllipsis(breadcrumb.BreadcrumbEllipsisArgs{})
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/components"}) {
										Components
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbPage(breadcrumb.BreadcrumbPageArgs{}) {
										Breadcrumb
									}
								}
							}
						}
					}
				}
				<!-- Breadcrumb with Dropdown -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							With Dropdown
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Breadcrumb ellipsis that opens a dropdown menu with hidden items.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						{{
							dropdownID := "breadcrumb-dropdown"
						}}
						@breadcrumb.Breadcrumb(breadcrumb.BreadcrumbArgs{}) {
							@breadcrumb.BreadcrumbList(breadcrumb.BreadcrumbListArgs{}) {
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/"}) {
										Home
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									<div class="relative">
										@dropdown.DropdownMenu(dropdown.DropdownMenuArgs{ID: dropdownID}) {
											@dropdown.DropdownMenuTrigger(dropdown.DropdownMenuTriggerArgs{
												ID:    dropdownID,
												Class: "flex items-center gap-1",
											}) {
												@breadcrumb.BreadcrumbEllipsis(breadcrumb.BreadcrumbEllipsisArgs{
													Class: "h-4 w-4",
												})
												<span class="sr-only">Toggle menu</span>
											}
											@dropdown.DropdownMenuContent(dropdown.DropdownMenuContentArgs{
												ID:    dropdownID,
												Align: "start",
											}) {
												@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
													ID: dropdownID,
												}) {
													Documentation
												}
												@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
													ID: dropdownID,
												}) {
													Themes
												}
												@dropdown.DropdownMenuItem(dropdown.DropdownMenuItemArgs{
													ID: dropdownID,
												}) {
													GitHub
												}
											}
										}
									</div>
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/components"}) {
										Components
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{})
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbPage(breadcrumb.BreadcrumbPageArgs{}) {
										Breadcrumb
									}
								}
							}
						}
					}
				}
				<!-- Custom Separator -->
				@card.Card(card.CardArgs{}) {
					@card.CardHeader(card.CardHeaderArgs{}) {
						@card.CardTitle(card.CardTitleArgs{}) {
							Custom Separator
						}
						@card.CardDescription(card.CardDescriptionArgs{}) {
							Override the default chevron separator with custom content.
						}
					}
					@card.CardContent(card.CardContentArgs{}) {
						@breadcrumb.Breadcrumb(breadcrumb.BreadcrumbArgs{}) {
							@breadcrumb.BreadcrumbList(breadcrumb.BreadcrumbListArgs{}) {
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/"}) {
										Home
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{CustomIcon: true}) {
									<span class="text-muted-foreground">/</span>
								}
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbLink(breadcrumb.BreadcrumbLinkArgs{Href: "/components"}) {
										Components
									}
								}
								@breadcrumb.BreadcrumbSeparator(breadcrumb.BreadcrumbSeparatorArgs{CustomIcon: true}) {
									<span class="text-muted-foreground">/</span>
								}
								@breadcrumb.BreadcrumbItem(breadcrumb.BreadcrumbItemArgs{}) {
									@breadcrumb.BreadcrumbPage(breadcrumb.BreadcrumbPageArgs{}) {
										Breadcrumb
									}
								}
							}
						}
					}
				}
			</div>
		</div>
	}
}
