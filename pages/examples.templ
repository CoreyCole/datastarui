package pages

import l "github.com/coreycole/datastarui/layouts"
import b "github.com/coreycole/datastarui/components/breadcrumb"

templ ExamplesPage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<div class="min-h-screen bg-background">
			<div class="container mx-auto px-4 py-8">
				<div class="flex flex-col space-y-8">
					<!-- Breadcrumb Navigation -->
					@b.Breadcrumb(b.BreadcrumbArgs{}) {
						@b.BreadcrumbList(b.BreadcrumbListArgs{}) {
							@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
								@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/"}) {
									Home
								}
							}
							@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
							@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
								@b.BreadcrumbPage(b.BreadcrumbPageArgs{}) {
									Examples
								}
							}
						}
					}
					<!-- Page Header -->
					<div class="space-y-2">
						<h1 class="text-3xl font-bold tracking-tight">Examples</h1>
						<p class="text-lg text-muted-foreground">
							Real-world examples and templates built with DatastarUI.
						</p>
					</div>
					<!-- Content -->
					<div class="space-y-8">
						<div class="space-y-4">
							<h2 class="text-2xl font-semibold tracking-tight">Breadcrumb Component</h2>
							<p class="text-muted-foreground">
								The breadcrumb component provides navigation context and helps users understand their location within the application.
							</p>
						</div>
						<!-- Basic Breadcrumb Example -->
						<div class="space-y-4">
							<h3 class="text-xl font-semibold">Basic Breadcrumb</h3>
							<div class="p-4 border rounded-lg">
								@b.Breadcrumb(b.BreadcrumbArgs{}) {
									@b.BreadcrumbList(b.BreadcrumbListArgs{}) {
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/"}) {
												Home
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/components"}) {
												Components
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbPage(b.BreadcrumbPageArgs{}) {
												Breadcrumb
											}
										}
									}
								}
							</div>
						</div>
						<!-- Breadcrumb with Ellipsis Example -->
						<div class="space-y-4">
							<h3 class="text-xl font-semibold">Breadcrumb with Ellipsis</h3>
							<div class="p-4 border rounded-lg">
								@b.Breadcrumb(b.BreadcrumbArgs{}) {
									@b.BreadcrumbList(b.BreadcrumbListArgs{}) {
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/"}) {
												Home
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbEllipsis(b.BreadcrumbEllipsisArgs{})
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/components"}) {
												Components
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{})
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbPage(b.BreadcrumbPageArgs{}) {
												Breadcrumb
											}
										}
									}
								}
							</div>
						</div>
						<!-- Custom Separator Example -->
						<div class="space-y-4">
							<h3 class="text-xl font-semibold">Custom Separator</h3>
							<div class="p-4 border rounded-lg">
								@b.Breadcrumb(b.BreadcrumbArgs{}) {
									@b.BreadcrumbList(b.BreadcrumbListArgs{}) {
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/"}) {
												Home
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{CustomIcon: true}) {
											<span class="text-muted-foreground">/</span>
										}
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbLink(b.BreadcrumbLinkArgs{Href: "/components"}) {
												Components
											}
										}
										@b.BreadcrumbSeparator(b.BreadcrumbSeparatorArgs{CustomIcon: true}) {
											<span class="text-muted-foreground">/</span>
										}
										@b.BreadcrumbItem(b.BreadcrumbItemArgs{}) {
											@b.BreadcrumbPage(b.BreadcrumbPageArgs{}) {
												Breadcrumb
											}
										}
									}
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
