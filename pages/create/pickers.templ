package create

import (
	"github.com/coreycole/datastarui/registry"
)

// PresetPicker allows selecting a preset configuration
templ PresetPicker(config registry.DesignSystemConfig) {
	{{
		currentPreset := registry.MatchPreset(config)
		presetName := "Custom"
		if currentPreset != nil {
			presetName = currentPreset.Title
		}
	}}
	<div class="space-y-3">
		<div class="flex items-center justify-between">
			<label class="text-sm font-medium">Preset</label>
			<span class="text-sm text-muted-foreground">{ presetName }</span>
		</div>
		<div class="space-y-2">
			for _, preset := range registry.AllPresets() {
				{{
					isSelected := currentPreset != nil && currentPreset.Name == preset.Name
					presetURL := buildConfigURL(preset.Config)
				}}
				<button
					type="button"
					class={
						"flex items-center gap-3 w-full p-3 rounded-lg border transition-all text-left",
						templ.KV("border-primary bg-primary/5", isSelected),
						templ.KV("border-border hover:border-primary/50", !isSelected),
					}
					data-on:click={ getClickAction(presetURL) }
				>
					<div
						class={
							"w-4 h-4 rounded-full border-2 flex items-center justify-center shrink-0",
							templ.KV("border-primary", isSelected),
							templ.KV("border-muted-foreground", !isSelected),
						}
					>
						if isSelected {
							<div class="w-2 h-2 rounded-full bg-primary"></div>
						}
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium">{ preset.Title }</div>
						<div class="text-xs text-muted-foreground truncate">{ preset.Description }</div>
					</div>
				</button>
			}
		</div>
	</div>
}

// StylePicker allows selecting a style variant
templ StylePicker(config registry.DesignSystemConfig) {
	<div class="space-y-3">
		<label class="text-sm font-medium">Style</label>
		<div class="grid grid-cols-5 gap-2">
			for _, style := range registry.AllStyles() {
				{{
					isSelected := config.Style == style.Name
					newURL := buildURL(config, "style", style.Name)
				}}
				<button
					type="button"
					class={
						"px-2 py-2 text-xs rounded-md border transition-all",
						templ.KV("border-primary bg-primary/10 text-foreground", isSelected),
						templ.KV("border-border hover:border-primary/50 text-muted-foreground hover:text-foreground", !isSelected),
					}
					data-on:click={ getClickAction(newURL) }
					title={ style.Description }
				>
					{ style.Title }
				</button>
			}
		</div>
	</div>
}

// BaseColorPicker allows selecting a base color
templ BaseColorPicker(config registry.DesignSystemConfig) {
	<div class="space-y-3">
		<label class="text-sm font-medium">Base Color</label>
		<div class="grid grid-cols-4 gap-2">
			for _, bc := range registry.BaseColors() {
				{{
					isSelected := config.BaseColor == bc.Name
					newURL := buildURL(config, "baseColor", bc.Name)
					// Get a representative color from the theme
					bgColor := bc.CSSVars.Light["muted"]
					if bgColor == "" {
						bgColor = bc.CSSVars.Light["secondary"]
					}
				}}
				<button
					type="button"
					class={
						"h-10 w-full rounded-md border-2 transition-all flex items-center justify-center",
						templ.KV("border-primary ring-2 ring-primary/20", isSelected),
						templ.KV("border-border hover:border-primary/50", !isSelected),
					}
					style={ "background-color: " + bgColor }
					data-on:click={ getClickAction(newURL) }
					title={ bc.Title }
				>
					<span class="sr-only">{ bc.Title }</span>
					<span class="text-xs font-medium text-foreground/70">{ bc.Title }</span>
				</button>
			}
		</div>
	</div>
}

// ThemePicker allows selecting an accent theme
templ ThemePicker(config registry.DesignSystemConfig) {
	{{
		// Get accent themes (includes current base color + all non-base themes)
		themes := registry.AccentThemes(config.BaseColor)
	}}
	<div class="space-y-3">
		<label class="text-sm font-medium">Theme Color</label>
		<div class="grid grid-cols-7 gap-2">
			for _, theme := range themes {
				{{
					isSelected := config.Theme == theme.Name
					primaryColor := theme.CSSVars.Light["primary"]
					if primaryColor == "" {
						primaryColor = theme.CSSVars.Light["foreground"]
					}
					newURL := buildURL(config, "theme", theme.Name)
				}}
				<button
					type="button"
					class={
						"h-8 w-full rounded-md border-2 transition-all",
						templ.KV("border-foreground ring-2 ring-foreground/20", isSelected),
						templ.KV("border-transparent hover:border-foreground/30", !isSelected),
					}
					style={ "background-color: " + primaryColor }
					data-on:click={ getClickAction(newURL) }
					title={ theme.Title }
				>
					<span class="sr-only">{ theme.Title }</span>
				</button>
			}
		</div>
	</div>
}

// FontPicker allows selecting a font
templ FontPicker(config registry.DesignSystemConfig) {
	<div class="space-y-3">
		<label class="text-sm font-medium">Font</label>
		<div class="grid grid-cols-2 gap-2">
			for _, font := range registry.AllFonts() {
				{{
					isSelected := config.Font == font.Value
					newURL := buildURL(config, "font", font.Value)
				}}
				<button
					type="button"
					class={
						"px-3 py-2 text-sm rounded-md border transition-all text-left truncate",
						templ.KV("border-primary bg-primary/10", isSelected),
						templ.KV("border-border hover:border-primary/50", !isSelected),
					}
					style={ "font-family: " + font.FontFamily }
					data-on:click={ getClickAction(newURL) }
				>
					{ font.Name }
				</button>
			}
		</div>
	</div>
}

// RadiusPicker allows selecting a border radius
templ RadiusPicker(config registry.DesignSystemConfig) {
	<div class="space-y-3">
		<label class="text-sm font-medium">Radius</label>
		<div class="flex gap-1 p-1 bg-muted rounded-lg">
			for _, radius := range registry.AllRadii() {
				{{
					isSelected := config.Radius == radius.Name
					newURL := buildURL(config, "radius", radius.Name)
				}}
				<button
					type="button"
					class={
						"flex-1 px-2 py-1.5 text-xs font-medium rounded-md transition-all",
						templ.KV("bg-background text-foreground shadow-sm", isSelected),
						templ.KV("text-muted-foreground hover:text-foreground", !isSelected),
					}
					data-on:click={ getClickAction(newURL) }
				>
					{ radius.Label }
				</button>
			}
		</div>
	</div>
}

