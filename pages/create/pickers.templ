// IconLibraryPicker allows selecting an icon library
templ IconLibraryPicker(config registry.DesignSystemConfig) {
	<div class="space-y-3">
		<label class="text-sm font-medium">Icon Library</label>
		<div class="grid grid-cols-2 gap-2">
			for _, lib := range registry.AllIconLibraries() {
				{{
					isSelected := config.IconLibrary == lib.Name
					newURL := buildURL(config, "iconLibrary", lib.Name)
				}}
				<button
					type="button"
					class={
						"p-3 rounded-md border transition-all text-left",
						templ.KV("border-primary bg-primary/10", isSelected),
						templ.KV("border-border hover:border-primary/50", !isSelected),
					}
					data-on:click={ getClickAction(newURL) }
				>
					<div class="text-sm font-medium">{ lib.Title }</div>
					<div class="text-xs text-muted-foreground">{ lib.Description }</div>
				</button>
			}
		</div>
	</div>
}

// ShuffleButton generates a random configuration
templ ShuffleButton() {
	{{
		randomURL := buildRandomConfigURL()
	}}
	<button
		type="button"
		data-on:click={ getClickAction(randomURL) }
		class="w-full px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
	>
		<svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
		</svg>
		Try Random
	</button>
}

// ResetButton returns to default configuration
templ ResetButton() {
	{{
		defaultConfig := registry.DefaultConfig()
		resetURL := buildConfigURL(defaultConfig)
	}}
	<button
		type="button"
		data-on:click={ getClickAction(resetURL) }
		class="w-full px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
	>
		<svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
		</svg>
		Reset to Default
	</button>
}

// ShareButton copies the current URL to clipboard
templ ShareButton() {
	<button
		type="button"
		data-on:click="navigator.clipboard.writeText(window.location.href); evt.target.textContent = 'Copied!'; setTimeout(() => evt.target.innerHTML = '<svg class=\\'w-4 h-4 inline-block mr-2\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z\\'></path></svg>Share URL', 2000)"
		class="w-full px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
	>
		<svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
		</svg>
		Share URL
	</button>
}
